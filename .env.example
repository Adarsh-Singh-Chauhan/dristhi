# Copy to .env and set strong secrets before deployment.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=60

# Local development uses SQLite when DATABASE_URL is blank.
DATABASE_PATH=data/drishti.db

# Production: paste the pooled PostgreSQL connection string from Neon.
# Never commit the real connection string.
DATABASE_URL=

# Replace example origins with the actual deployed frontend URL.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
