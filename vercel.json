{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "regions": [
    "bom1"
  ],
  "redirects": [
    {
      "source": "/frontend/demo.html",
      "destination": "/demo.html",
      "permanent": true
    },
    {
      "source": "/frontend/",
      "destination": "/app.html",
      "permanent": true
    },
    {
      "source": "/frontend/index.html",
      "destination": "/app.html",
      "permanent": true
    },
    {
      "source": "/frontend/guide.html",
      "destination": "/guide.html",
      "permanent": true
    },
    {
      "source": "/frontend/admin.html",
      "destination": "/admin.html",
      "permanent": true
    },
    {
      "source": "/frontend/alerts.html",
      "destination": "/alerts.html",
      "permanent": true
    }
  ]
}
